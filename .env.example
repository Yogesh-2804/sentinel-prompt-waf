# SentinelPrompt Environment Configuration Example
# Copy this file to .env before running docker compose up --build

# Environment & General Settings
PROJECT_NAME="SentinelPrompt WAF"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Admin Authentication Credentials (DO NOT HARDCODE REAL SECRETS)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"
SECRET_KEY="your-secure-jwt-signing-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Host & Ports
HOST="0.0.0.0"
PORT=8000
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"
DATABASE_URL_SYNC="sqlite:///./sentinel.db"

# LLM Gateway Configuration
DEFAULT_LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3"

# Optional Cloud LLM API Keys (Leave blank for local Ollama)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
CLAUDE_API_KEY=""

# Security Thresholds
STATIC_THREAT_THRESHOLD=0.70
ML_THREAT_THRESHOLD=0.65
SEMANTIC_SIMILARITY_THRESHOLD=0.85
OVERALL_BLOCK_THRESHOLD=0.60
