# General Configuration
PROJECT_NAME="SentinelPrompt WAF"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security & Admin Configuration
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"
SECRET_KEY="change-me-to-a-secure-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backend Host & Port
HOST="0.0.0.0"
PORT=8000

# Database Settings
DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"
DATABASE_URL_SYNC="sqlite:///./sentinel.db"
REDIS_URL="redis://localhost:6379/0"

# LLM Gateway Configuration
DEFAULT_LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="tinyllama"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-3-haiku-20240307"

# Security Detection Thresholds
STATIC_THREAT_THRESHOLD=0.7
ML_THREAT_THRESHOLD=0.65
SEMANTIC_SIMILARITY_THRESHOLD=0.85
OVERALL_BLOCK_THRESHOLD=0.60

# Vector DB Settings
FAISS_INDEX_PATH="./data/faiss_index.bin"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
